# ============================================================
# App
# ============================================================
NODE_ENV=development
PORT=3001
APP_NAME=vibe-chat
API_PREFIX=api
API_VERSION=1

# ============================================================
# Database — TiDB Cloud (MySQL-compatible)
# Lấy từ: TiDB Cloud Console -> Cluster -> Connect
# KHÔNG commit file .env (chỉ commit .env.example)
# ============================================================
DB_TYPE=mysql
DB_HOST=gateway01.ap-southeast-1.prod.alicloud.tidbcloud.com
DB_PORT=4000
DB_USERNAME=xxxxxxxxxxxxxxx.root
DB_PASSWORD=__REPLACE_ME__
DB_DATABASE=vibe_chat
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
# Bật log SQL ở dev, TẮT ở prod
DB_LOGGING=true
# CHỈ bật ở local dev tuyệt đối an toàn — không bao giờ true ở staging/prod
DB_SYNCHRONIZE=false

# ============================================================
# Keycloak (sẽ dùng ở module auth)
# ============================================================
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=vibe-chat
KEYCLOAK_CLIENT_ID=vibe-chat-backend
KEYCLOAK_CLIENT_SECRET=__REPLACE_ME__

# ============================================================
# Encryption (cho mã hoá tin nhắn AES-256-GCM)
# Tạo key 32 byte: openssl rand -base64 32
# ============================================================
MESSAGE_ENCRYPTION_KEK_BASE64=__REPLACE_ME__

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
